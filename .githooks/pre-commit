#!/usr/bin/env bash
# ============================================================
#  COMMIT-SPERRE MARKENFLÄCHE  ·  Vorgang WF-A4E0 (Meldung #552)
#  ------------------------------------------------------------
#  WARUM ES DIESEN HAKEN GIBT (04.10.2026):
#    Das README ist eine Markenfläche – es wird indexiert und steht bei
#    einer Markensuche neben dem Ratgeber. Betriebssprache (Automatik,
#    Abläufe, Gates, Dateipfade) gehört nach docs/ENTWICKLER-WERKZEUGE.md.
#    Zweimal innerhalb einer Woche (01.10. und 03.10.2026) landete sie
#    trotzdem wieder im README; beide Male fiel es erst NACH dem Push auf
#    – als roter Lauf samt öffentlich sichtbarer Fehlermeldung.
#    Dieser Haken zieht die Grenze dorthin, wo der Fehler entsteht.
#
#  WAS ER TUT:
#    · nur aktiv, wenn README, Allowlist oder die Wache selbst gestaget sind
#    · prüft den GESTAGETEN Stand (nicht den Arbeitsbaum – `git add -p`!)
#    · läuft offline, ohne Netz, ohne Token, in unter einer Sekunde
#    · beweist zuerst sich selbst (--selftest): ein blinder Haken wäre
#      schlimmer als keiner
#
#  EINSCHALTEN:  Von allein. `scripts/haken_wache.py` hängt diesen Haken bei
#    `npm install` (prepare) und bei jedem Marken-Lauf als Weiterleitung in die
#    benutzte Hakenablage ein – vorhandene Haken bleiben dabei am Leben.
#    Von Hand: `npm run hooks:install` · Kontrolle: `npm run hooks:status`
#  NOTAUSGANG :  git commit --no-verify  – dann hält das Gate im Push-Lauf.
# ============================================================
set -euo pipefail

WURZEL="$(git rev-parse --show-toplevel)"

# ============================================================
#  TEIL 0 (06.11.2026, Vorgang WF-8F6F / #1073): KONFLIKTMARKER
#  ------------------------------------------------------------
#  Am 05.11.2026 kam ein unaufgelöst aufgelöster Merge nach `main`
#  (PR #1088): `BEFUND-AKTE.md` und `data/faktenfrische_befunde_state.json`
#  enthielten `<<<<<<< HEAD … ======= … >>>>>>> f77c0af`. Kein lokaler
#  Haken und kein Commit-Pfad hatte es gesehen – der Artefakt-Wächter
#  deckt nur data/** ab, der Deploy nur content/layouts/static/hugo.toml.
#  Diese Sperre prüft den GESTAGETEN Stand aller Dateitypen mit dem
#  Block-Automaten scripts/konfliktmarker_wache.py (Haus-Docstrings mit
#  Sieben-Gleichheitszeichen-Überschriften sind kein Fund).
#  Rot heißt rot; Notausgang wie überall: git commit --no-verify.
# ============================================================
cd "$WURZEL"
if [ ! -f scripts/konfliktmarker_wache.py ]; then
  if git cat-file -e HEAD:scripts/konfliktmarker_wache.py 2>/dev/null ||
     git ls-files --error-unmatch scripts/konfliktmarker_wache.py >/dev/null 2>&1; then
    echo "🛑 Konfliktmarker-Sperre: Wache fehlt – Commit gestoppt."
    exit 1
  fi
  echo "::warning:: Konfliktmarker-Sperre im Minimal-Repository nicht installiert."

else
  if ! command -v python3 >/dev/null 2>&1; then
    echo "🛑 Konfliktmarker-Sperre: python3 fehlt – der gestagete Stand ist ungeprüft."
    exit 1
  fi
  if ! python3 scripts/konfliktmarker_wache.py --staged; then
    echo "🛑 Konfliktmarker-Sperre: Unaufgelöster Merge gestaget – Commit gestoppt."
    echo "   Heilung: Konfliktblock bewusst auflösen (eine Seite je Block);"
    echo "   maschinengenerierte Dateien neu erzeugen"
    echo "   (z. B. python3 scripts/faktenfrische_befund_akte.py --schreiben)."
    exit 1
  fi
fi
# ============================================================
#  TEIL 2 (04.11.2026, WF-829B / #1039): DAS SIEGEL WIRD HIER GEPRÜFT
#  ------------------------------------------------------------
#  Zwei Fehlerklassen, ein Ort: Am 02.11.2026 kam ein Siegel nach `main`,
#  in dem drei Fassungen zeilenweise übereinanderlagen – `"signed_at"` und
#  `"head"` je dreimal, `"files"` je zweimal. Gefunden hat es erst ein
#  PR-Gate, Tage später; die Läufe davor waren grün, weil ein fehlendes
#  Komma NICHT jede Fassung erwischte. Am selben Tag hinterließ ein Merge
#  bei `skills_vertrag.py` doppelte Funktionsdefinitionen und ein kaputtes
#  `scripts/safe_xml.py`-Modul. Beides ist die Klasse „Maschinen-Artefakt
#  oder Regelkern wird mit Text-Merge behandelt".
#
#  Geprüft wird der GESTAGETE Stand, nicht der Arbeitsbaum – dieselbe Regel
#  wie oben, und in einem Wegwerf-Verzeichnis (der Baum bleibt unberührt, C15).
#  Gefragt wird genau das, was am 02.11. gefehlt hat:
#    · steht im Siegel ein Schlüssel MEHRFACH (Zusammenschnitt zweier
#      Fassungen)? – `integrity_guard._doppelte_schluessel`,
#    · ist das Siegel gesund (JSON, Kette, Map-Prüfsumme)? – derselbe
#      Prüfer, den das PR-Gate benutzt; keine zweite Wahrheit.
#  Rot heißt rot: kein Override über die Umgebung, nur `--no-verify` (dann
#  hält das PR-Gate). Offline, ohne Token, unter einer Sekunde.
# ============================================================
SIEGEL_BETROFFEN=0
if printf '%s\n' "$(git diff --cached --name-only --diff-filter=ACMR || true)" \
    | grep -qE '^(data/integrity_lock\.json|data/integrity_history\.jsonl)$'; then
  SIEGEL_BETROFFEN=1
fi

if [ "$SIEGEL_BETROFFEN" -eq 1 ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "🛑 Siegel-Sperre: python3 fehlt – der gestagete Stand ist ungeprüft."
    exit 1
  fi
  cd "$WURZEL"
  # Der gestagete Stand ist die Wahrheit des Commits. Geprüft wird er in
  # einem Wegwerf-Baum: der Arbeitsbaum wird dabei NICHT angefasst (C15).
  PRUEFSTAND_SIEGEL="$(mktemp -d -t siegel-XXXXXX)"
  # EIN Trap für beide Prüfstände: der zweite `trap` weiter unten würde den
  # ersten sonst ERSETZEN – und dieser Ordner bliebe liegen (Lehre aus C15:
  # ein Prüf-Aufruf hinterlässt nichts).
  trap 'rm -rf "$PRUEFSTAND_SIEGEL" "${PRUEFSTAND:-}"' EXIT
  git show :data/integrity_lock.json > "$PRUEFSTAND_SIEGEL/lock.json" 2>/dev/null || : > "$PRUEFSTAND_SIEGEL/lock.json"
  if ! python3 - "$PRUEFSTAND_SIEGEL/lock.json" <<'PY'
import sys
from pathlib import Path

sys.path.insert(0, "scripts")
import integrity_guard as ig  # noqa: E402

text = Path(sys.argv[1]).read_text(encoding="utf-8")
doppelt = ig._doppelte_schluessel(text)
if doppelt:
    print("🛑 Siegel-Sperre: doppelte Objektschlüssel im gestageten Siegel: "
          + ", ".join(doppelt))
    print("   Das ist ein Zusammenschnitt zweier Fassungen – `json.loads()` "
          "nimmt still den letzten Wert.")
    print("   Reparatur: python3 scripts/integrity_guard.py --repair-lock")
    sys.exit(1)
_, befund = ig._zustand_aus_bytes(text.encode("utf-8"))
if befund["zustand"] not in ig.GESUND:
    print("🛑 Siegel-Sperre: " + ig.ZUSTAND_KLARTEXT.get(befund["zustand"],
                                                         befund["zustand"]))
    for zeile in ig.lock_zustand_text(befund, praefix="   "):
        print(zeile)
    print("   Reparatur: python3 scripts/integrity_guard.py --repair-lock")
    sys.exit(1)
print("✅ Siegel-Sperre: gestageter Lock ist gesund und aus EINER Fassung.")
PY
  then
    exit 1
  fi
fi

WACHE="scripts/brand_surface_guard.py"

GESTAGET="$(git diff --cached --name-only --diff-filter=ACMR || true)"
betrifft_marke=0
for pfad in README.md data/brand_surface_allowlist.txt "$WACHE"; do
  if printf '%s\n' "$GESTAGET" | grep -qxF "$pfad"; then betrifft_marke=1; fi
done
[ "$betrifft_marke" -eq 1 ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
  echo "🛑 Markenflächen-Sperre: python3 fehlt – der Stand ist ungeprüft."
  echo "   Entweder python3 installieren oder bewusst umgehen:"
  echo "   git commit --no-verify   (dann prüft der Push-Lauf)"
  exit 1
fi

cd "$WURZEL"

if ! python3 "$WACHE" --selftest >/dev/null; then
  echo "🛑 Markenflächen-Sperre: Der Selbsttest der Wache ist rot – es wird"
  echo "   nichts freigegeben, solange der Detektor selbst nicht beweisbar ist."
  python3 "$WACHE" --selftest || true
  exit 1
fi

PRUEFSTAND="$(mktemp -d -t markenflaeche-XXXXXX)"
# Kein zweiter `trap`: der oben räumt BEIDE Prüfstände (Siegel + Markenfläche).

if printf '%s\n' "$GESTAGET" | grep -qxF "README.md"; then
  # Der gestagete Inhalt ist die Wahrheit des Commits – nicht die Datei auf Platte.
  git show :README.md > "$PRUEFSTAND/README.md"
else
  cp "$WURZEL/README.md" "$PRUEFSTAND/README.md"
fi

if python3 "$WACHE" --only readme --gate --offline --datei "$PRUEFSTAND/README.md"; then
  exit 0
fi

cat <<'HINWEIS'

🛑 Markenflächen-Sperre: Betriebssprache im README (Commit gestoppt).

   Das README ist die öffentliche Markenfläche. Technische Abschnitte
   (Automatik, Abläufe, Gates, Werkzeugnamen, Dateipfade) gehören nach
   docs/ENTWICKLER-WERKZEUGE.md – im README steht nur der Verweis.

   Wege nach vorn:
     1. Abschnitt verschieben  → docs/ENTWICKLER-WERKZEUGE.md
     2. Begründete Ausnahme    → data/brand_surface_allowlist.txt
                                 (eine Regex pro Zeile, Begründung im Kommentar)
     3. Erneut prüfen          → npm run marke:check
     4. Bewusst umgehen        → git commit --no-verify
                                 (dann meldet es der Push-Lauf öffentlich)

   Hintergrund: docs/MARKEN-OBERFLAECHE-RUNBOOK.md
HINWEIS
exit 1
