FROM python:3.14-slim

# ============================================================
#  Dockerfile.whisper — Lokaler Whisper-API-Server (0 € Kosten)
# ============================================================

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Sicherheitsaudit 14.10.2026 (N-11) & Tiefencheck 30.10.2026:
# 1) Aktuelle, gepatchte Web-Schicht (python-multipart 0.0.32, uvicorn 0.54.0,
#    fastapi 0.143.1). Dependabot (docker/pip) pflegt die Versionen weiter.
# 2) Build-Werkzeuge (build-essential, git) werden in derselben RUN-Schicht
#    nach pip install wieder entfernt, damit im Laufzeit-Image nur ffmpeg
#    und curl verbleiben (minimale Angriffsfläche).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    git \
    build-essential \
    && pip install --no-cache-dir \
        fastapi==0.143.1 \
        uvicorn==0.54.0 \
        python-multipart==0.0.32 \
        faster-whisper==1.0.3 \
    && apt-get purge -y --auto-remove git build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY whisper_server.py /app/whisper_server.py

# Nicht als root laufen; Modell-Cache im Home des Dienstnutzers.
RUN useradd --create-home --uid 10001 whisper \
    && mkdir -p /home/whisper/.cache/huggingface \
    && chown -R whisper:whisper /home/whisper /app
USER whisper
ENV HOST=0.0.0.0

EXPOSE 8765

CMD ["python3", "whisper_server.py"]
