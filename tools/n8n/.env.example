# ============================================================
#  Konfigurationsvorlage für n8n & lokales Whisper (0 € Stack)
# ============================================================

# n8n Einstellungen
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Whisper Lokaler Dienst
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_API_URL=http://whisper-api:8765/v1/audio/transcriptions

# GitHub Webhook & API Authentifizierung (optional für automatischen Push)
GITHUB_REPOSITORY=frank-hartung/franksfinanzcheck-blog
GITHUB_BRANCH=main
GITHUB_TOKEN=
