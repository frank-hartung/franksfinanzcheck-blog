# ============================================================
#  Konfigurationsvorlage für n8n & lokales Whisper (0 € Stack)
# ============================================================

# n8n Einstellungen
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Whisper Lokaler Dienst
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_API_URL=http://whisper-api:8765/v1/audio/transcriptions

# Whisper-Zugangsschlüssel (PFLICHT seit 15.10.2026): jede Anfrage braucht
# "Authorization: Bearer <WHISPER_TOKEN>". Ohne Token verweigert der Dienst
# die Arbeit – und docker compose startet gar nicht erst (fail closed).
# Erzeugen: openssl rand -hex 32
WHISPER_TOKEN=
# In n8n: Credential „FF Whisper-Token" anlegen – Typ „Header Auth",
# Header-Name  Authorization,  Wert  Bearer <WHISPER_TOKEN>.
# Der Workflow „1_voice_memo_to_blog_draft" trägt diese Credential am Knoten
# „Lokales Whisper" – ohne sie verweigert der Dienst die Arbeit (fail closed).
# Hinweis: Leer lassen ist erlaubt – aber dann verweigert der Dienst die
# Arbeit (HTTP 503). Nur fuer eine bewusste lokale Probe ohne Schutz:
# WHISPER_OHNE_TOKEN_OK=1 in tools/n8n/.env setzen.

# Gemeinsames Webhook-Secret (PFLICHT seit 15.10.2026) für n8n-Webhooks und
# den Python-Bridge-Server: Der Bridge-Server nimmt POSTs nur mit dem Kopf
# "X-Webhook-Secret: <N8N_WEBHOOK_TOKEN>" an; in n8n tragen die Webhook-Knoten
# die Credential "FF Webhook-Secret" mit demselben Wert (Header-Name
# X-Webhook-Secret). Erzeugen: openssl rand -hex 32
N8N_WEBHOOK_TOKEN=
WHISPER_MAX_UPLOAD_MB=50

# Cookies nur über HTTPS (Standard). Nur für reinen localhost-Betrieb ohne
# TLS auf false setzen.
N8N_SECURE_COOKIE=true

# GitHub (optional, Sicherheitsaudit 14.10.2026): NUR ein Fine-grained-Token
# auf genau dieses Repo mit "Actions: write" (für repository_dispatch) –
# KEIN Contents-Schreibrecht, kein klassischer PAT. Diese Datei (.env) ist
# per .gitignore vom Commit ausgeschlossen.
GITHUB_REPOSITORY=frank-hartung/franksfinanzcheck-blog
GITHUB_BRANCH=main
GITHUB_TOKEN=
