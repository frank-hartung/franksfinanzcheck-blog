# ============================================================
#  Konfigurationsvorlage für n8n & lokales Whisper (0 € Stack)
# ============================================================

# n8n Einstellungen
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Whisper Lokaler Dienst
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_API_URL=http://whisper-api:8765/v1/audio/transcriptions

# Whisper-Zugangsschlüssel (empfohlen): jede Anfrage braucht dann
# "Authorization: Bearer <WHISPER_TOKEN>". Erzeugen: openssl rand -hex 32
WHISPER_TOKEN=
WHISPER_MAX_UPLOAD_MB=50

# Cookies nur über HTTPS (Standard). Nur für reinen localhost-Betrieb ohne
# TLS auf false setzen.
N8N_SECURE_COOKIE=true

# GitHub (optional, Sicherheitsaudit 14.10.2026): NUR ein Fine-grained-Token
# auf genau dieses Repo mit "Actions: write" (für repository_dispatch) –
# KEIN Contents-Schreibrecht, kein klassischer PAT. Diese Datei (.env) ist
# per .gitignore vom Commit ausgeschlossen.
GITHUB_REPOSITORY=frank-hartung/franksfinanzcheck-blog
GITHUB_BRANCH=main
GITHUB_TOKEN=
