    "spam:status": "python3 scripts/spam_schutz_wache.py --json",
    "spam:notbremse": "python3 -c \"import json;s=json.load(open('data/spam_schutz_status.json'));print('Urteil:',s['urteil'],'| Probleme:',s['probleme'])\"",
    "test:spam": "python3 -m unittest scripts.tests.test_spam_schutz_wache",
    "kosten:sperre": "python3 scripts/kostensperre.py",
    "kosten:pruefen": "python3 scripts/kostensperre.py --pruefen",
    "test:kosten": "python3 scripts/kostensperre.py --selftest && python3 -m unittest scripts.tests.test_kostensperre",
    "build:vertrag": "python3 scripts/hugo_build_vertrag.py",
    "build:selftest": "python3 scripts/hugo_build_vertrag.py --selftest",
    "test:build": "python3 scripts/hugo_build_vertrag.py --selftest && python3 -m unittest scripts.tests.test_hugo_build_vertrag",
    "marke:check": "python3 scripts/haken_wache.py --install --leise; python3 scripts/brand_surface_guard.py --selftest && python3 scripts/brand_surface_guard.py --only readme --gate --offline",
    "marke:befund": "python3 scripts/brand_surface_guard.py --gate",
    "test:marke": "python3 scripts/brand_surface_guard.py --selftest && python3 scripts/haken_wache.py --selftest && python3 -m unittest scripts.tests.test_markenflaeche_readme scripts.tests.test_haken_wache",
