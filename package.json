{
  "name": "franksfinanzcheck-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E-Tests (Playwright) für FranksFinanzcheck – Startseite, Artikel, Navigation, SEO/A11y und Affiliate-Integrität. Siehe e2e/ und .github/workflows/e2e.yml.",
  "scripts": {
    "build": "hugo --destination public",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:debug": "playwright test --debug",
    "seo:audit": "hugo --minify --cleanDestinationDir && python3 scripts/seo_cockpit.py",
    "seo:check": "hugo --minify --cleanDestinationDir && python3 scripts/seo_cockpit.py --strict",
    "seo:serve": "python3 -m http.server 4174 --bind 127.0.0.1 --directory .cache/seo-cockpit",
    "test:seo": "python3 -m unittest discover -s scripts/tests -p \"test_seo_cockpit.py\" && node --test tools/seo-cockpit/app.test.cjs",
    "test:seo:browser": "node --test tools/seo-cockpit/browser.test.mjs",
    "design:liste": "python3 scripts/design_variant_lab.py --liste",
    "design:gate": "python3 scripts/design_variant_gate.py",
    "design:wache": "python3 scripts/design_variant_gate.py --produktionswache",
    "design:lauf": "python3 scripts/design_variant_lab.py --lauf",
    "design:messen": "node e2e/variant-metrics.mjs --variante",
    "design:lighthouse": "python3 scripts/design_variant_gate.py --lighthouse-export && node e2e/variant-metrics.mjs --variante ${LHCI_VARIANTE:-basis}",
    "design:briefing": "python3 scripts/design_reach_briefing.py",
    "design:handoff": "python3 scripts/design_handoff.py",
    "design:handoff:check": "python3 scripts/design_handoff.py --check",
    "design:quality": "npm run design:handoff:check && npm run design:gate && npm run test:design",
    "test:design": "python3 -m unittest scripts.tests.test_design_varianten",
    "test:toc": "node scripts/ff_toc_beweglich_test.mjs && node scripts/ff_heading_glyph_guard_test.mjs && python3 scripts/mini_toc_premium_guard.py --selftest && python3 scripts/mini_toc_premium_guard.py",
    "test:imartikel": "python3 scripts/mini_toc_premium_guard.py --selftest && python3 scripts/mini_toc_premium_guard.py",
    "dialog": "python3 scripts/social_dialog.py --run",
    "dialog:probe": "python3 scripts/social_dialog.py --run --dry-run",
    "dialog:status": "python3 scripts/social_dialog.py --status",
    "test:dialog": "python3 scripts/social_dialog.py --selftest",
    "shorts:plan": "python3 scripts/social_video.py --plan",
    "shorts:drehbuch": "python3 scripts/social_video.py --drehbuch",
    "shorts:bauen": "python3 scripts/social_video.py --bauen --limit 1",
    "shorts:umgebung": "python3 scripts/social_video.py --pruefe-umgebung",
    "test:shorts": "python3 scripts/social_video.py --selftest",
    "social:preflight": "python3 scripts/social_preflight.py",
    "social:kalender": "python3 scripts/social_calendar.py --build",
    "test:social:kalender": "python3 scripts/social_calendar.py --selftest",
    "social:preflight:offline": "python3 scripts/social_preflight.py --offline",
    "test:social:preflight": "python3 scripts/social_preflight.py --selftest",
    "faktenfrische": "python3 scripts/faktenfrische.py",
    "faktenfrische:neu": "python3 scripts/faktenfrische.py --neu --apply",
    "faktenfrische:bestand": "python3 scripts/faktenfrische.py --apply",
    "test:faktenfrische": "python3 scripts/faktenfrische.py --selftest",
    "rechtschreibung:zeit": "python3 scripts/zeit_rechtschreibung.py",
    "rechtschreibung:zeit:fix": "python3 scripts/zeit_rechtschreibung.py --fix",
    "rechtschreibung:zeit:offline": "python3 scripts/zeit_rechtschreibung.py --offline",
    "rechtschreibung:zeit:strict": "python3 scripts/zeit_rechtschreibung.py --strict",
    "rechtschreibung:zeit:probe": "python3 scripts/zeit_rechtschreibung.py --probe",
    "test:rechtschreibung": "python3 scripts/zeit_rechtschreibung.py --selftest && python3 -m unittest scripts.tests.test_zeit_rechtschreibung",
    "offenlegung": "hugo --minify --destination public --cleanDestinationDir && python3 scripts/offenlegung_gate.py",
    "offenlegung:json": "python3 scripts/offenlegung_gate.py --json --no-report",
    "test:offenlegung": "python3 scripts/offenlegung_gate.py --selftest && python3 -m unittest scripts.tests.test_offenlegung_gate"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0"
  },
  "dependencies": {
    "jsdom": "^30.1.1"
  }
}
