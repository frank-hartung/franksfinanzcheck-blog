    "schaltwerk:status": "python3 scripts/schaltwerk.py --status",
    "test:schaltwerk": "python3 scripts/schaltwerk.py --selftest && python3 -m unittest scripts.tests.test_schaltwerk",
    "whisper:inbox": "python3 scripts/whisper_engine.py --watch-dir data/whisper_inbox/",
    "whisper:selftest": "python3 scripts/whisper_engine.py --selftest",
    "n8n:ping": "python3 scripts/n8n_bridge.py --ping",
    "n8n:serve": "python3 scripts/n8n_bridge.py --serve --port 5680",
    "n8n:selftest": "python3 scripts/n8n_bridge.py --selftest",
    "blogautomatik:status": "python3 scripts/blogautomatik_orchestrator.py --status",
    "blogautomatik:audit": "python3 scripts/blogautomatik_orchestrator.py --audit",
    "blogautomatik:pipeline": "python3 scripts/blogautomatik_orchestrator.py --pipeline voice-to-publish",
