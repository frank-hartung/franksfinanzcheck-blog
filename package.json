    "test:tabellen": "python3 scripts/tabellen_lesbarkeit_guard.py --selftest && python3 -m unittest scripts.tests.test_tabellen_lesbarkeit_guard",
    "redaktion:ymyl": "python3 scripts/editorial_review_gate.py --all --report",
    "redaktion:ymyl:strict": "python3 scripts/editorial_review_gate.py --all --strict",
    "redaktion:ymyl:published": "python3 scripts/editorial_review_gate.py --published --strict",
    "test:redaktion:ymyl": "python3 scripts/editorial_review_gate.py --selftest && python3 -m unittest scripts.tests.test_editorial_review_gate",
    "vergleiche:check": "python3 scripts/vergleichsgrundsaetze_gate.py --selftest && python3 scripts/vergleichsgrundsaetze_gate.py --source-only && hugo --minify --cleanDestinationDir && python3 scripts/vergleichsgrundsaetze_gate.py",
    "test:vergleiche": "python3 scripts/vergleichsgrundsaetze_gate.py --selftest",
    "engine:kapazitaet": "python3 scripts/engine_capacity.py",
