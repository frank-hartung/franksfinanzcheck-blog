    "werkbank:status": "python3 scripts/antwortwerk.py --status",
    "werkbank:json": "python3 scripts/werkbank_gate.py --json --no-cockpit",
    "werkbank:strict": "python3 scripts/werkbank_gate.py --strict",
    "antwortwerk": "python3 scripts/antwortwerk.py --plan",
    "antwortwerk:frage": "python3 scripts/antwortwerk.py --frage",
    "antwortwerk:probe": "python3 scripts/antwortwerk.py --plan --dry-run",
    "antwortwerk:offline": "python3 scripts/antwortwerk.py --plan --offline --dry-run",
    "test:werkbank": "python3 scripts/antwortwerk.py --selftest && python3 scripts/werkbank_gate.py --selftest && python3 -m unittest scripts.tests.test_werkbank",
    "ki:transportweg": "python3 scripts/ki_transportweg.py",
    "ki:status": "python3 scripts/ki_transportweg.py --status",
    "ki:json": "python3 scripts/ki_transportweg.py --json --no-cockpit",
    "ki:ping": "python3 scripts/ki_transportweg.py --ping",
    "ki:strict": "python3 scripts/ki_transportweg.py --strict",
