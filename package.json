{
  "name": "franksfinanzcheck-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E-Tests (Playwright) für FranksFinanzcheck – Startseite, Artikel, Navigation, SEO/A11y und Affiliate-Integrität. Siehe e2e/ und .github/workflows/e2e.yml.",
  "scripts": {
    "suchindex": "rm -rf public/pagefind && pagefind --site public --force-language de --exclude-selectors 'a.anchor' && python3 scripts/suchindex_check.py --site public",
    "suchindex:pruefen": "python3 scripts/suchindex_check.py --site public",
    "test:suche": "node --test tools/ff-suche.test.mjs && python3 scripts/suchindex_check.py --selftest && python3 -m unittest scripts.tests.test_suche_pagefind",
    "test:suche:browser": "playwright test e2e/suche.spec.mjs",
    "provisionen:check": "python3 scripts/provisionen_check.py --summary",
    "build": "hugo --destination public && npm run --silent suchindex",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:debug": "playwright test --debug",
    "tags": "python3 scripts/tag_governance.py --report",
    "tags:check": "python3 scripts/tag_governance.py --check",
    "tags:fix": "python3 scripts/tag_governance.py --apply",
    "index:hygiene": "hugo --minify --cleanDestinationDir && python3 scripts/index_hygiene_gate.py",
    "test:index:hygiene": "python3 scripts/tag_governance.py --selftest && python3 scripts/index_hygiene_gate.py --selftest",
    "seo:audit": "hugo --minify --cleanDestinationDir && python3 scripts/seo_cockpit.py",
    "seo:check": "hugo --minify --cleanDestinationDir && python3 scripts/seo_cockpit.py --strict",
    "seo:serve": "python3 -m http.server 4174 --bind 127.0.0.1 --directory .cache/seo-cockpit",
    "test:seo": "python3 -m unittest discover -s scripts/tests -p \"test_seo_cockpit.py\" && node --test tools/seo-cockpit/app.test.cjs",
    "automation:audit": "python3 scripts/automation_premium_audit.py",
    "automation:audit:json": "python3 scripts/automation_premium_audit.py --json",
    "test:seo:browser": "node --test tools/seo-cockpit/browser.test.mjs",
    "design:liste": "python3 scripts/design_variant_lab.py --liste",
    "design:gate": "python3 scripts/design_variant_gate.py",
    "design:wache": "python3 scripts/design_variant_gate.py --produktionswache",
    "design:lauf": "python3 scripts/design_variant_lab.py --lauf",
    "design:messen": "node e2e/variant-metrics.mjs --variante",
    "design:lighthouse": "python3 scripts/design_variant_gate.py --lighthouse-export && node e2e/variant-metrics.mjs --variante ${LHCI_VARIANTE:-basis}",
    "design:briefing": "python3 scripts/design_reach_briefing.py",
    "design:handoff": "python3 scripts/design_handoff.py",
    "design:handoff:check": "python3 scripts/design_handoff.py --check",
    "design:quality": "npm run design:handoff:check && npm run design:gate && npm run test:design",
    "test:design": "python3 -m unittest scripts.tests.test_design_varianten",
    "test:toc": "node scripts/ff_toc_beweglich_test.mjs && node scripts/ff_heading_glyph_guard_test.mjs && python3 scripts/mini_toc_premium_guard.py --selftest && python3 scripts/mini_toc_premium_guard.py",
    "cockpit:check": "python3 scripts/fixkosten_kompass_guard.py --selftest && python3 scripts/fixkosten_kompass_guard.py --source-only && hugo --minify --cleanDestinationDir && python3 scripts/fixkosten_kompass_guard.py --public public",
    "test:cockpit": "python3 -m unittest scripts.tests.test_fixkosten_kompass && node --test tools/fixkosten-cockpit.test.mjs",
    "werkzeuge:check": "python3 scripts/werkzeuge_gate.py --selftest && python3 scripts/werkzeuge_gate.py --source-only && hugo --minify --cleanDestinationDir && python3 scripts/werkzeuge_gate.py --public public",
    "test:werkzeuge": "python3 -m unittest scripts.tests.test_werkzeuge_gate && node --test tools/werkzeuge.test.mjs",
    "robustheit": "python3 scripts/robustheits_gate.py --source-only",
    "robustheit:check": "python3 scripts/robustheits_gate.py --selftest && python3 scripts/robustheits_gate.py --source-only && hugo --minify --cleanDestinationDir && python3 scripts/robustheits_gate.py --public public --strict",
    "robustheit:strict": "python3 scripts/robustheits_gate.py --source-only --json --strict",
    "robustheit:ausnahmen": "python3 -c \"import sys;sys.path.insert(0,'scripts');import robustheits_gate as g;from pathlib import Path;[print(a) for a in g.genutzte_ausnahmen(Path('.'))]\"",
    "test:robustheit": "python3 scripts/robustheits_gate.py --selftest && python3 -m unittest scripts.tests.test_robustheits_gate && node --test tools/robust.test.mjs tools/ki-assistent.test.mjs",
    "h1:check": "python3 scripts/h1_wache.py --selftest && python3 -m unittest scripts.tests.test_h1_wache scripts.tests.test_a11y_audit && python3 scripts/h1_wache.py --source-only && hugo --minify --cleanDestinationDir && python3 scripts/h1_wache.py --public public",
    "a11y:check": "python3 scripts/h1_wache.py --selftest && python3 -m unittest scripts.tests.test_h1_wache scripts.tests.test_a11y_audit && python3 scripts/h1_wache.py --source-only && hugo --minify --cleanDestinationDir && python3 scripts/h1_wache.py --public public && python3 scripts/a11y_audit.py",
    "test:h1": "python3 -m unittest scripts.tests.test_h1_wache scripts.tests.test_a11y_audit",
    "test:a11y": "python3 -m unittest scripts.tests.test_a11y_audit",
    "authority:check": "python3 scripts/authority_engine.py --check",
    "authority:selftest": "python3 scripts/authority_engine.py --selftest && python3 -m unittest scripts.tests.test_authority_engine",
    "test:imartikel": "python3 scripts/mini_toc_premium_guard.py --selftest && python3 scripts/mini_toc_premium_guard.py",
    "dialog": "python3 scripts/social_dialog.py --run",
    "dialog:probe": "python3 scripts/social_dialog.py --run --dry-run",
    "dialog:status": "python3 scripts/social_dialog.py --status",
    "test:dialog": "python3 scripts/social_dialog.py --selftest",
    "poppy:sammeln": "python3 scripts/poppy_ingest.py",
    "poppy:watchlist": "python3 scripts/poppy_ingest.py --watchlist",
    "poppy:verwerten": "python3 scripts/poppy_repurpose.py --auto",
    "poppy:board": "python3 scripts/poppy_board.py",
    "poppy:serve": "python3 -m http.server 4178 --bind 127.0.0.1 --directory .cache/poppy-board",
    "test:poppy": "python3 scripts/poppy_ingest.py --selftest && python3 scripts/poppy_repurpose.py --selftest && python3 scripts/poppy_board.py --selftest && python3 -m unittest scripts.tests.test_poppy_werkbank",
    "endredaktion": "python3 scripts/endredaktion.py",
    "endredaktion:pruefen": "python3 scripts/endredaktion.py --nur-pruefen",
    "endredaktion:status": "python3 scripts/endredaktion.py --status",
    "test:endredaktion": "python3 scripts/endredaktion.py --selftest && python3 -m unittest scripts.tests.test_endredaktion",
    "schaltwerk": "python3 scripts/schaltwerk.py --run",
    "schaltwerk:probe": "python3 scripts/schaltwerk.py --dry-run",
