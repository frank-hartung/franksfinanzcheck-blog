    "engine:slots": "python3 scripts/slot_wache.py --pruefen --ohne-dispatch",
    "test:engine:kapazitaet": "python3 scripts/engine_capacity.py --selftest && python3 -m unittest scripts.tests.test_engine_capacity",
    "test:engine:slots": "python3 scripts/slot_wache.py --selftest && python3 -m unittest scripts.tests.test_slot_wache",
    "engine:deficit": "python3 scripts/engine_issue.py --lage",
