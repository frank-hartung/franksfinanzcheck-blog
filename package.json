    "release:scorecard": "python3 scripts/release_scorecard.py",
    "release:bestand": "python3 scripts/release_scorecard.py --live --streng",
    "release:artikel": "python3 scripts/release_scorecard.py --slug",
    "test:release": "python3 scripts/release_scorecard.py --selftest && python3 -m unittest scripts.tests.test_release_scorecard",
    "spam:check": "python3 scripts/spam_schutz_wache.py",
