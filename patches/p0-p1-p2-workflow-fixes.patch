+# ============================================================
+#  AFFILIATE-DAILY – Gemerged P2-Fix 31.08.2026
+#
+#  Vorher: 2 Workflows
+#    - affiliate-health.yml (Mo 11:30, E2E mit Netz)
+#    - affiliate-integrity-daily.yml (täglich 06:00, Render-Beweis)
+#  Jetzt: 1 Workflow täglich 06:00, 2 Phasen:
+#    Phase 1 --no-net: PID-Integrität + Gateway-Drift (offline, schnell)
+#    Phase 2 --with-net: E2E Redirect-Kette + Render-Beweis (mit Netz)
+#
+#  Spart 1 Cron, verhindert Doppel-Issues, heilt sofort.
+# ============================================================
+name: Affiliate-Daily (Integrität + Health)
+
+on:
+  schedule:
+    - cron: "0 4 * * *"    # 06:00 MESZ – vor Content-Engine 08:10
+  workflow_dispatch: {}
+
+permissions:
+  contents: write
+  issues: write
+
+concurrency:
+  group: affiliate-daily
+  cancel-in-progress: false
+
+jobs:
+  affiliate:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Pip-Cache
+        uses: actions/cache@v4
+        with:
+          path: ~/.cache/pip
+          key: ${{ runner.os }}-pip-aff-${{ hashFiles('**/requirements*.txt') }}
+          restore-keys: |
+            ${{ runner.os }}-pip-
+
+      - uses: actions/setup-python@v7
+        with:
+          python-version: "3.12"
+          cache: 'pip'
+
+      - name: Deps
+        run: |
+          pip install -q pyyaml
+          sudo apt-get install -y -qq hunspell hunspell-de-de >/dev/null 2>&1
+
+      - name: Hugo
+        uses: peaceiris/actions-hugo@v3
+        with:
+          hugo-version: "0.164.0"
+          extended: true
+
+      - name: Phase 1 – Offline-Kontrakt (--no-net) – PID + Gateway-Drift
+        id: offline
+        continue-on-error: true
+        run: |
+          python3 scripts/affiliate_health.py --no-net | tee /tmp/offline.log
+          exit ${PIPESTATUS[0]}
+
+      - name: Hugo-Build für Render-Beweis
+        run: hugo --minify
+
+      - name: Phase 2 – Integrität + E2E (--with-net)
+        id: gate
+        continue-on-error: true
+        run: |
+          python3 scripts/affiliate_integrity_gate.py | tee /tmp/integrity.log
+          python3 scripts/affiliate_health.py --issue | tee /tmp/health.log || echo "Health-Check meldet Issue – siehe Report"
+
+      - name: Commit Heilungen
+        run: |
+          git config user.name "Affiliate-Bot"
+          git config user.email "affiliate-bot@users.noreply.github.com"
+          git add content/ 2>/dev/null || true
+          git add AFFILIATE-HEALTH-REPORT.md 2>/dev/null || true
+          git add AFFILIATE-INTEGRITY-REPORT.md 2>/dev/null || true
+          git add scripts/check24_links.yaml 2>/dev/null || true
+          git add static/go/ 2>/dev/null || true
+          if git diff --cached --quiet; then
+            echo "Keine Affiliate-Heilungen"
+          else
+            git commit -m "fix(affiliate): Daily – Offline-Kontrakt + Integrität + E2E geheilt (P2-Fix gemerged)"
+            SYNC_OK_VAR=GEHEILT scripts/git_sync.sh --push-only
+          fi
+
+      - name: Deploy bei Heilung
+        if: env.GEHEILT == 'true'
+        uses: actions/github-script@v7
+        with:
+          script: |
+            await github.rest.actions.createWorkflowDispatch({
+              owner: context.repo.owner, repo: context.repo.repo,
+              workflow_id: 'deploy.yml', ref: 'main',
+            });
+
+      - name: Issue bei Rest-Problemen
+        if: steps.offline.outcome == 'failure' || steps.gate.outcome == 'failure'
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const fs = require('fs');
+            let details = '';
+            try { details += fs.readFileSync('AFFILIATE-INTEGRITY-REPORT.md','utf-8').slice(0,3000); } catch(e){}
+            try { details += '\n\n---\n'+fs.readFileSync('AFFILIATE-HEALTH-REPORT.md','utf-8').slice(0,3000); } catch(e){}
+            await github.rest.issues.create({
+              owner: context.repo.owner, repo: context.repo.repo,
+              title: '🔗 Affiliate-Daily: Rest-Probleme',
+              body: details
+            });
