diff --git a/.github/workflows/restore-drill.yml b/.github/workflows/restore-drill.yml
new file mode 100644
index 0000000..4be313a
--- /dev/null
+++ b/.github/workflows/restore-drill.yml
@@ -0,0 +1,48 @@
+# ============================================================
+#  RESTORE-DRILL (Agentur-Stufe-2, 27.08.2026)
+#  ------------------------------------------------------------
+#  Ein nie getestetes Backup ist kein Backup. Dieser Drill beweist
+#  QUARTALSWEISE, dass das tägliche Offsite-Backup (backup-offsite.yml
+#  → Release-Asset backup.bundle) vollständig wiederherstellbar ist:
+#
+#    Bundle aus dem neuesten backup-*-Release laden → Klon →
+#    Struktur-Verifikation (HEAD, hugo.toml, ≥20 Artikel, Impressum,
+#    Datenschutz) → Beweis-Build mit Hugo → lautes Rot bei Defekt
+#    (Fehler-Alerting öffnet ein Issue).
+#
+#  Termin: 1. Jan/Apr/Jul/Okt 05:00 UTC – bewusst VOR dem Quartals-
+#  Artikel-Update (06:00 UTC); das Backup des Vortages reicht als
+#  Beweisobjekt.
+#  Lokal testbar: bash scripts/restore_drill.sh --bundle <datei.bundle>
+# ============================================================
+name: Restore-Drill
+
+on:
+  schedule:
+    - cron: "0 5 1 1,4,7,10 *"   # 1. Jan/Apr/Jul/Okt ~07:00 MEZ/MESZ
+  workflow_dispatch: {}
+
+permissions:
+  contents: read
+
+concurrency:
+  group: restore-drill
+  cancel-in-progress: false
+
+jobs:
+  drill:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Repository auschecken (nur für das Skript)
+        uses: actions/checkout@v4
+
+      - name: Hugo installieren (für den Beweis-Build)
+        uses: peaceiris/actions-hugo@v3
+        with:
+          hugo-version: "0.164.0"
+          extended: true
+
+      - name: Restore-Drill ausführen (neuestes backup-*-Release)
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: bash scripts/restore_drill.sh
diff --git a/.github/workflows/weekly-digest.yml b/.github/workflows/weekly-digest.yml
