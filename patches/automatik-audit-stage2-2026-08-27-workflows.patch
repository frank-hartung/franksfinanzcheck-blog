+++ b/.github/workflows/weekly-digest.yml
@@ -0,0 +1,44 @@
+# ============================================================
+#  WOCHEN-DIGEST (Agentur-Stufe-2, 27.08.2026)
+#  ------------------------------------------------------------
+#  Jeden Montag 20:00 MESZ (18:00 UTC): kompiliert ALLE Automatik-
+#  Kanäle der letzten Woche zu EINEM GitHub-Issue (Label `digest`):
+#  Artikel, Mastodon, Pinterest-Pins, Spam-Funde, Audit-Events,
+#  fehlgeschlagene Workflow-Läufe, Themenpool, Engine-Status.
+#  Der Vorwochen-Digest wird automatisch geschlossen (max. 1 offen).
+#
+#  Montag abends gewählt: Die Woche ist komplett (So = letzter Tag),
+#  keine Kollision mit den Mo-Morgen-Werken (06:45–11:30 UTC) und
+#  dem Pinterest-Peak (19–22 Uhr DE) – der Digest braucht nur Lese-
+#  Zugriffe + Issue-Recht, pusht NICHT nach main.
+# ============================================================
+name: Wochen-Digest (Automatik)
+
+on:
+  schedule:
+    - cron: "0 18 * * 1"    # Mo 20:00 MESZ / 19:00 MEZ
+  workflow_dispatch: {}
+
+permissions:
+  contents: read
+  issues: write
+
+concurrency:
+  group: weekly-digest
+  cancel-in-progress: false
+
+jobs:
+  digest:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Repository auschecken
+        uses: actions/checkout@v4
+
+      - name: Python-Abhängigkeiten
+        run: python3 -m pip install -q pyyaml
+
+      - name: Wochen-Digest erzeugen + als Issue veröffentlichen
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+          GITHUB_REPOSITORY: ${{ github.repository }}
+        run: python3 scripts/weekly_digest.py
