+      - name: Rechtschreib-Whitelist absorbieren (korrekte Komposita ≥ 3 Artikel)
+        # absorb_whitelist.py: Korrekte deutsche Komposita, die Hunspell nicht
+        # kennt (Spontankäufen, Dispokredite, …) und in ≥ 3 Artikeln vorkommen,
+        # werden in data/spellcheck_whitelist.txt aufgenommen → das dauerhafte
+        # „Unbekanntes Wort“-Rauschen sinkt, ohne echte Tippfehler zu maskieren
+        # (ein Tippfehler wiederholt sich praktisch nie in 3 Artikeln).
+        # Non-blocking: Absorb ist Rausch-Senke, kein Gate.
+        continue-on-error: true
+        run: |
+          python3 scripts/absorb_whitelist.py --apply | tee /tmp/absorb_log.txt
+          exit ${PIPESTATUS[0]}
