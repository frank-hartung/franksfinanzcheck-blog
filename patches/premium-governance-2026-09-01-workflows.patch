diff --git a/.github/workflows/premium-governance.yml b/.github/workflows/premium-governance.yml
new file mode 100644
index 0000000..916d268
--- /dev/null
+++ b/.github/workflows/premium-governance.yml
@@ -0,0 +1,172 @@
+# ============================================================
+#  PREMIUM-GOVERNANCE (Chefredakteur-Scorecard + Decay + CWV + Secrets)
+#
+#  Die "Blatt-Steuerung" für FranksFinanzcheck – wöchentlich (Mo 07:15 MESZ):
+#   1. Chefredakteur-Scorecard  – eine zentrale Ampel über ALLE Signale
+#   2. Content-Decay-Radar       – welche YMYL-/Stichtag-Artikel veralten
+#   3. Core-Web-Vitals-Wächter    – Performance-Soll-Ist (nach Hugo-Build)
+#   4. Secrets-/Token-Alters-Wache – lautloser Kanaltod-Prävention
+#
+#  Bei Handlungsbedarf wird EIN gebündeltes GitHub-Issue (Label `governance`)
+#  geöffnet. Alle Reports/Manifeste werden committet (Selbstheilung-Doku).
+#
+#  Kein API-Key nötig; nur Umgebungsvariablen für die Secrets-Wache lesen.
+# ============================================================
+name: Premium-Governance
+
+on:
+  schedule:
+    - cron: "15 5 * * 1"    # Montag 07:15 MESZ – Redaktions-Checkpoint
+  workflow_dispatch: {}
+
+permissions:
+  contents: write
+  issues: write
+
+concurrency:
+  group: premium-governance
+  cancel-in-progress: false
+
+jobs:
+  governance:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Repository auschecken
+        uses: actions/checkout@v4
+
+      - name: Hugo installieren (für CWV-Build)
+        uses: peaceiris/actions-hugo@v3
+        with:
+          hugo-version: "0.164.0"
+          extended: true
+
+      - name: Python-Abhängigkeiten
+        run: python3 -m pip install -q pyyaml 2>/dev/null || true
+
+      - name: Hugo-Build (für Core-Web-Vitals-Wächter)
+        run: hugo --minify > /dev/null 2>&1 || true
+
+      # ---------- 1) CHEFREDAKTEUR-SCORECARD ----------
+      - name: Chefredakteur-Scorecard
+        id: scorecard
+        continue-on-error: true
+        run: |
+          python3 scripts/editorial_scorecard.py | tee /tmp/scorecard.log
+          exit ${PIPESTATUS[0]}
+
+      # ---------- 2) CONTENT-DECAY-RADAR ----------
+      - name: Content-Decay-Radar
+        id: decay
+        continue-on-error: true
+        run: |
+          python3 scripts/decay_radar.py | tee /tmp/decay.log
+          exit ${PIPESTATUS[0]}
+
+      # ---------- 3) CORE-WEB-VITALS-WÄCHTER ----------
+      - name: Core-Web-Vitals-Wächter
+        id: cwv
+        continue-on-error: true
+        run: |
+          python3 scripts/cwv_guard.py --public public/ | tee /tmp/cwv.log
+          exit ${PIPESTATUS[0]}
+
+      # ---------- 4) SECRETS-/TOKEN-ALTERS-WACHE ----------
+      - name: Secrets-/Token-Alters-Wache
+        id: secrets
+        continue-on-error: true
+        env:
+          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
+          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
+          PINTEREST_ACCESS_TOKEN: ${{ secrets.PINTEREST_ACCESS_TOKEN }}
+          MASTODON_ACCESS_TOKEN: ${{ secrets.MASTODON_ACCESS_TOKEN }}
+          PINTEREST_TOKEN_KEY: ${{ secrets.PINTEREST_TOKEN_KEY }}
+        run: |
+          python3 scripts/secrets_age_guard.py | tee /tmp/secrets.log
+          exit ${PIPESTATUS[0]}
+
+      # ---------- 5) PINTEREST-PERFORMANCE-FEEDBACK (Themen-Gewichtung) ----------
+      # Liest die Analytics-Daten (data/pinterest_perf.yaml bzw. --fetch mit
+      # read_ads-Token) und gewichtet den Themenpool der Content-Engine.
+      - name: Pinterest-Performance-Feedback
+        id: pinperf
+        continue-on-error: true
+        env:
+          PINTEREST_ACCESS_TOKEN: ${{ secrets.PINTEREST_ACCESS_TOKEN }}
+        run: |
+          python3 scripts/pinterest_perf_feedback.py | tee /tmp/pinperf.log
+          exit ${PIPESTATUS[0]}
+
+      # ---------- 6) AFFILIATE-KLICK-ATTRIBUTION (/go/-Gateway) ----------
+      # Liest den Umami-affiliate_click-Export (data/umami_clicks.json) und
+      # priorisiert Content nach Umsatz-Hebel.
+      - name: Affiliate-Klick-Attribution
+        id: clicks
+        continue-on-error: true
+        run: |
+          python3 scripts/click_attribution.py | tee /tmp/clicks.log
+          exit ${PIPESTATUS[0]}
+
+      # ---------- 7) AWIN-PROVISIONS-IMPORT (Klicks → Umsatz) ----------
+      # Liest den Awin-Transaktions-Export (data/awin_transactions.csv) und
+      # aggregiert Provisionen pro Artikel (SubID→Slug). DSGVO-sicher: nur
+      # Summen, keine Kundendaten. Der Import läuft nur, wenn der CSV vorliegt;
+      # sonst meldet das Skript "keine Daten" (kein Abbruch).
+      - name: Awin-Provisions-Import
+        id: awin
+        continue-on-error: true
+        run: |
+          python3 scripts/awin_provisions.py | tee /tmp/awin.log
+          exit ${PIPESTATUS[0]}
+
+      - name: Erfolgreiche Secrets vermerken (pro Kanal)
+        if: always()
+        env:
+          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
+          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
+        run: |
+          # Nur vermerken, wenn das Secret wirklich gesetzt & genutzt wurde.
+          if [ -n "${GROQ_API_KEY:-}" ]; then python3 scripts/secrets_age_guard.py --record-success GROQ_API_KEY || true; fi
+          if [ -n "${GEMINI_API_KEY:-}" ]; then python3 scripts/secrets_age_guard.py --record-success GEMINI_API_KEY || true; fi
+
+      # ---------- COMMIT (Reports + Manifeste) ----------
+      - name: Reports & Manifeste committen
+        if: always()
+        run: |
+          git config user.name "Governance-Bot"
+          git config user.email "governance-bot@users.noreply.github.com"
+          git add EDITORIAL-SCORECARD.md DECAY-REPORT.md CWV-REPORT.md SECRETS-REPORT.md 2>/dev/null || true
+          git add PINTEREST-PERF-REPORT.md CLICK-REPORT.md AWIN-REPORT.md 2>/dev/null || true
+          git add data/decay_queue.json data/cwv_manifest.json data/secrets_state.json 2>/dev/null || true
+          git add data/pinterest_weights.yaml data/click_stats.json data/pinterest_perf_history.jsonl 2>/dev/null || true
+          git add data/awin_provisions.json data/subid_map.yaml 2>/dev/null || true
+          if git diff --cached --quiet; then
+            echo "Governance: keine Änderungen."
+          else
+            git commit -m "governance: Scorecard + Decay + CWV + Secrets + Pinterest-Perf + Klick-Attribution + Awin (wöchentlich)"
+            scripts/git_sync.sh --push-only
+          fi
+
+      # ---------- GEBÜNDELTES ISSUE ----------
+      - name: Governance-Issue bei Handlungsbedarf
+        if: failure() || steps.scorecard.outcome == 'failure' || steps.decay.outcome == 'failure' || steps.cwv.outcome == 'failure' || steps.secrets.outcome == 'failure' || steps.pinperf.outcome == 'failure' || steps.clicks.outcome == 'failure' || steps.awin.outcome == 'failure'
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const fs = require('fs');
+            let body = '## 🗞️ Governance-Report (wöchentlich)\n\n';
+            try { body += '### Scorecard\n\n```\n' + fs.readFileSync('EDITORIAL-SCORECARD.md', 'utf-8') + '\n```\n'; } catch (e) {}
+            try { body += '### Decay-Radar\n\n```\n' + fs.readFileSync('/tmp/decay.log', 'utf-8') + '\n```\n'; } catch (e) {}
+            try { body += '### CWV\n\n```\n' + fs.readFileSync('/tmp/cwv.log', 'utf-8') + '\n```\n'; } catch (e) {}
+            try { body += '### Secrets\n\n```\n' + fs.readFileSync('/tmp/secrets.log', 'utf-8') + '\n```\n'; } catch (e) {}
+            try { body += '### Pinterest-Performance\n\n```\n' + fs.readFileSync('/tmp/pinperf.log', 'utf-8') + '\n```\n'; } catch (e) {}
+            try { body += '### Klick-Attribution\n\n```\n' + fs.readFileSync('/tmp/clicks.log', 'utf-8') + '\n```\n'; } catch (e) {}
+            try { body += '### Awin-Provisions\n\n```\n' + fs.readFileSync('/tmp/awin.log', 'utf-8') + '\n```\n'; } catch (e) {}
+            body += '\n---\nAutomatisch vom Premium-Governance-Workflow (Label: governance).';
+            await github.rest.issues.create({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              title: '🗞️ Governance-Report: Redaktionelle & technische Handlungsfelder',
+              body: body,
+              labels: ['governance']
+            });
+            console.log('✅ Governance-Issue erstellt');
