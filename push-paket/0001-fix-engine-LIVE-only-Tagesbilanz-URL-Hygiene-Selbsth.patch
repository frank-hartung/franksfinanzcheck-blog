+              f"{stats['files']} Datei(en) {verb}.")
+    else:
+        print("URL-Hygiene: keine Leerzeichen-URLs im Bestand – alle Links sauber.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
