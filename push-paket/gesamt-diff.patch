@@ -0,0 +1,187 @@
+# ============================================================
+#  KADENZ-ENDKONTROLLE (Premium-Fix 03.09.2026)
+#  ------------------------------------------------------------
+#  AUFTRAG: „Stelle sicher, dass am Montag/Mittwoch/Freitag 2 bis 3
+#  Blogartikel ZWINGEND veröffentlicht werden.“
+#
+#  KERNBEFUND (Mi 02.09.2026): Nur 1 statt 2–3 LIVE-Artikel. Ursache war
+#  eine Kette aus drei Fehlern:
+#    1) Ein fertiger Artikel scheiterte am Publish-Gate an einer bloßen
+#       Leerzeichen-URL (R8-URL-LEERZEICHEN) und wurde „gehalten“.
+#    2) Die Engine zählte diesen gleichtägigen Entwurf als belegten
+#       Tages-Slot → die Fallback-Slots (14:10/17:40 UTC) sahen den Tag
+#       als „voll“ und füllten das LIVE-Mindestziel nicht mehr auf.
+#    3) Kein Heiler hat die Fehlerklasse R8-URL-LEERZEICHEN behandelt,
+#       und es gab kein KI-unabhängiges Sicherheitsnetz.
+#
+#  DIESER WORKFLOW IST DAS LETZTE SICHERHEITSNETZ (4. Baustein):
+#  Er läuft an Mo/Mi/Fr um 21:05 UTC (23:05 MESZ) – NACH dem letzten
+#  Engine-Slot (17:40 UTC) und NACH der Produktions-Wache (20:00 UTC).
+#  Ablauf:
+#    1. Heilen (URL-Hygiene + deterministisch heilbare holds → Re-Queue
+#       + Kadenz-Fix: Re-Queue-Posts werden an Publikationstagen sofort
+#       wieder live geschaltet)
+#    2. LIVE-Zahl für heute zählen (nur draft: false, Frontmatter-Datum)
+#    3. Fehlt das Mindestziel → Reserve-Pool veröffentlichen
+#       (scripts/reserve_pool.py): fertige Premium-Evergreen-Artikel,
+#       die ohne KI-Verfügbarkeit live gehen können
+#    4. Qualitäts-Folgekette (Titel/Cover/URLs) + Commit + Push +
+#       expliziter Deploy-Anstoß (GITHUB_TOKEN-Commits triggern keine
+#       Workflows, deploy-catchup.yml fängt es zusätzlich ab)
+#    5. engine_issue --deficit am Ende: öffnet/schließt das Tagesdefizit-
+#       Issue automatisch – der Tag kann nie mehr still unter dem
+#       Mindestziel enden.
+# ============================================================
+name: Kadenz-Endkontrolle (Mo/Mi/Fr – 2–3 LIVE erzwingen)
+
+on:
+  schedule:
+    - cron: "5 21 * * 1,3,5"    # 23:05 MESZ – nach dem letzten Engine-Slot
+  workflow_dispatch: {}
+
+permissions:
+  contents: write
+  issues: write
+  actions: write
+
+concurrency:
+  group: kadenz-endkontrolle
+  cancel-in-progress: false
+
+env:
+  MIN_ARTIKEL_PRO_TAG: ${{ vars.MIN_ARTIKEL_PRO_TAG || '2' }}
+  STATUS: KADENZ-ENDKONTROLLE-STATUS.md
+
+jobs:
+  endkontrolle:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - name: Repository auschecken (main)
+        uses: actions/checkout@v4
+        with:
+          ref: main
+
+      - name: Frischesten Stand holen (parallele Bots möglich)
+        run: |
+          for i in 1 2 3; do
+            git pull --ff-only origin main && break || sleep 5
+          done
+
+      - name: Python + Abhängigkeiten
+        uses: actions/setup-python@v7
+        with:
+          python-version: "3.12"
+      - name: pip installieren
+        run: pip install --quiet "pyyaml==6.0.2" pillow pillow-avif-plugin fonttools brotli
+
+      # ---------- Baustein 1: Heilung (deterministisch, kein KI) ----------
+      - name: URL-Hygiene-Selbsttest
+        run: python3 scripts/fix_url_hygiene.py --selftest
+
+      - name: URL-Hygiene – Leerzeichen-URLs heilen
+        run: python3 scripts/fix_url_hygiene.py --fix || echo "⚠ Restfunde siehe Log"
+
+      - name: URL-Hygiene – deterministisch heilbare holds entblocken
+        run: python3 scripts/fix_url_hygiene.py --heal-holds
+
+      - name: Kadenz-Selbsttest + Kadenz-Fix (Re-Queue-Promotion am Publikationstag)
+        run: |
+          python3 scripts/cadence_guard.py --selftest
+          python3 scripts/cadence_guard.py --fix
+
+      - name: Heilungen committen & pushen
+        id: heal
+        run: |
+          git config user.name "Kadenz-Backstop"
+          git config user.email "kadenz-backstop@users.noreply.github.com"
+          git add content/ CADENCE-GATE-REPORT.md DRAFT-LINK-REPORT.md 2>/dev/null || true
+          if git diff --cached --quiet; then
+            echo "changed=0" >> "$GITHUB_OUTPUT"
+            echo "Keine Heilungen nötig."
+          else
+            git commit -m "fix: URL-Hygiene + Kadenz-Heilung (Kadenz-Endkontrolle)"
+            scripts/git_sync.sh --push-only
+            echo "changed=1" >> "$GITHUB_OUTPUT"
+            echo "Heilungen gepusht."
+          fi
+
+      # ---------- Baustein 2: LIVE-Zahl für heute prüfen ----------
+      - name: Heutige LIVE-Zahl ermitteln
+        id: live
+        run: |
+          python3 - <<'PYEOF'
+          import datetime, os, sys
+          sys.path.insert(0, "scripts")
+          import cadence_guard as cg
+          min_d, max_d = cg.effective_limits()
+          posts = cg.load_posts()
+          today = datetime.date.today()
+          live = len(cg.published_on(posts, today))
+          drafts = sum(1 for p in posts if p["date"] == today and p["draft"])
+          print(f"live={live} drafts={drafts} min={min_d} max={max_d}")
+          with open(os.environ["STATUS"], "w", encoding="utf-8") as f:
+              f.write("# Kadenz-Endkontrolle – Status\n\n")
+              f.write(f"**Stand:** {datetime.datetime.now(datetime.timezone.utc):%Y-%m-%d %H:%M} UTC  \n")
+              f.write(f"**Publikationstag:** {cg.DAYS_DE[today.weekday()]} ({today.isoformat()})  \n")
+              f.write(f"**LIVE heute:** {live} (Ziel {min_d}–{max_d}, {drafts} Entwurf(e))  \n")
+          with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as f:
+              f.write(f"live={live}\nmin={min_d}\nmax={max_d}\n")
+          PYEOF
+
+      # ---------- Baustein 3: Reserve-Pool als KI-unabhängiges Netz ----------
+      - name: Reserve-Pool veröffentlichen (nur wenn LIVE unter Mindestziel)
+        id: reserve
+        if: ${{ fromJSON(steps.live.outputs.live) < fromJSON(steps.live.outputs.min) }}
+        run: |
+          python3 scripts/reserve_pool.py --publish-to-min
+          # Nach der Veröffentlichung dieselbe Qualitäts-Folgekette wie die
+          # Engine (Titel-Gate, Covers, URL-Hygiene) – dann committen.
+          python3 scripts/check_titles.py --fix || echo "⚠ Titel-Gate – Funde im Log"
+          python3 scripts/generate_covers.py || echo "⚠ Cover-Generator – Funde im Log"
+          python3 scripts/check_covers.py --fix || echo "⚠ Cover-Gate – Funde im Log"
+          python3 scripts/fix_url_hygiene.py --fix || echo "⚠ URL-Hygiene – Funde im Log"
+          git config user.name "Kadenz-Backstop"
+          git config user.email "kadenz-backstop@users.noreply.github.com"
+          git add content/ static/images/covers/ CADENCE-GATE-REPORT.md DRAFT-LINK-REPORT.md 2>/dev/null || true
+          if git diff --cached --quiet; then
+            echo "published=0" >> "$GITHUB_OUTPUT"
+            echo "⚠ Reserve-Pool konnte nicht füllen (Pool leer?) – Defizit wird gemeldet."
+          else
+            git commit -m "content: Reserve-Pool füllt LIVE-Mindestziel (Kadenz-Endkontrolle)"
+            scripts/git_sync.sh --push-only
+            echo "published=1" >> "$GITHUB_OUTPUT"
+            echo "Reserve-Veröffentlichung gepusht."
+          fi
+
+      - name: Deploy explizit anstoßen (GITHUB_TOKEN-Commits triggern keine Workflows)
+        if: ${{ steps.heal.outputs.changed == '1' || steps.reserve.outputs.published == '1' }}
+        uses: actions/github-script@v7
+        with:
+          script: |
+            await github.rest.actions.createWorkflowDispatch({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              workflow_id: 'deploy.yml',
+              ref: 'main',
+            });
+            console.log('✅ Deploy ausgelöst (geheilte/veröffentlichte Inhalte werden live gebaut).');
+
+      # ---------- Baustein 4: Defizit sichtbar machen bzw. schließen ----------
+      - name: Tagesdefizit-Issue öffnen/schließen (engine_issue --deficit)
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          python3 scripts/engine_issue.py --deficit || echo "⚠ Defizit-Wache (nicht kritisch)"
+
+      - name: Status committen (kann nie einfrieren)
+        run: |
+          git config user.name "Kadenz-Backstop"
+          git config user.email "kadenz-backstop@users.noreply.github.com"
+          git add KADENZ-ENDKONTROLLE-STATUS.md
+          if git diff --cached --quiet; then
+            echo "Status unverändert."
+          else
+            git commit -m "docs: KADENZ-ENDKONTROLLE-STATUS aktualisiert"
+            scripts/git_sync.sh --push-only
+          fi
