{{- /* Sitemap der zur Indexierung vorgesehenen Originalseiten.
     Artikel, sechs Themen-Ratgeber, beide Hubs und Vertrauens-/Rechtsseiten.
     Keine Archive, Pager oder explizit ausgeschlossenen Seiten.
     lastmod wird ausschließlich aus belegten Redaktionsdaten abgeleitet;
     ohne Datum auf Einzel-/Rechtsseiten wird es weggelassen.
     priority/changefreq sind Hinweise, keine Rankingversprechen.
     GEO/SEO-PREMIUM 21.09.2026: Google-Bild-Sitemap (image:image) für alle
     Artikel- und Ratgeber-Cover – zweiter Discovery-Pfad für Google Bilder,
     Discover und Pinterest. Die Bild-Tags stehen ZWINGEND NACH priority:
     schema_seo_gate S7 parst `<loc>…</loc>\s*(<lastmod>)?` per Regex und
     meldet jeden Bild-Tag dazwischen als fehlendes lastmod. seo_cockpit.py
     liest nur direkte url/loc-Kinder (image:loc wird ignoriert).
     Regressionen: schema_seo_gate.py, seo_cockpit.py, seo-pagination.spec.mjs.
*/ -}}
{{- $seen := slice -}}
{{- $out := slice -}}
{{- /* ---- Hilfsfunktion: Seite würfeln (URL, lastmod, freq, prio) ---- */ -}}
{{- /* INDEX-HYGIENE 29.09.2026: /transparenz/ fehlte hier. Die Seite ist
       indexierbar (head.html setzt index,follow) und aus dem Footer verlinkt,
       stand aber in keiner Sitemap – für Google also nur über die interne
       Verlinkung auffindbar („Gefunden – zurzeit nicht indexiert"). Sie ist
       eine Vertrauensseite (E-E-A-T) und gehört damit zu den Money-Pages.
       Die beiden Verifikationsdateien (/google…html, /pinterest-e238f.html)
       bleiben bewusst draußen: sie sind Besitznachweise, keine Inhalte.
       Wache: scripts/index_hygiene_gate.py (H1). */ -}}
{{- /* BEWEISSYSTEM 01.10.2026: /aenderungsprotokoll/ ist die neue öffentliche
       Korrektur-/Beleg-Seite (E-E-A-T-Vertrauensseite wie /transparenz/) und
       gehört in die Sitemap. /cockpit/ (Produktkern, Commit „Fixkosten-
       Cockpit product core“) fehlte hier ebenfalls – Index-Hygiene-Wache H1
       meldete beide als „indexierbar, aber nur intern verlinkt“. */ -}}
{{- $legal := slice "impressum" "datenschutz" "ueber" "methodik" "transparenz" "aenderungsprotokoll" -}}
{{- /* ---------- 1) Startseite ---------- */ -}}
{{- with site.Home -}}
  {{- if and (not .Params.sitemap.disable) (ne .Params.robotsNoIndex true) -}}
    {{- $out = $out | append (dict "url" .Permalink "lastmod" (partial "sitemap_lastmod" .) "freq" "daily" "prio" 1.0) -}}
    {{- $seen = $seen | append .Permalink -}}
  {{- end -}}
{{- end -}}
{{- /* ---------- 2) Live-Artikel ---------- */ -}}
{{- range site.RegularPages -}}
  {{- if ne .Section "posts" }}{{ continue }}{{ end -}}
  {{- if or (.Params.sitemap.disable) (eq .Params.robotsNoIndex true) (in $seen .Permalink) }}{{ continue }}{{ end -}}
  {{- $pg := . -}}
  {{- $img := "" -}}{{- $imgT := "" -}}{{- $imgC := "" -}}
  {{- with .Params.cover.image -}}
    {{- $img = . | absURL -}}
    {{- $imgT = $pg.Title | plainify -}}
    {{- with $pg.Params.cover.alt -}}{{- $imgC = . | plainify -}}{{- end -}}
  {{- end -}}
  {{- $out = $out | append (dict "url" .Permalink "lastmod" (partial "sitemap_lastmod" .) "freq" "weekly" "prio" 0.8 "img" $img "imgtitle" $imgT "imgcap" $imgC) -}}
  {{- $seen = $seen | append .Permalink -}}
{{- end -}}
{{- /* ---------- 3) Pillar-Ratgeber (list: never → manuell) ---------- */ -}}
{{- $pillars := slice "strom-sparen" "versicherungen" "mietwagen" "frugalismus" "internet-dsl" "konto-karten" -}}
{{- range $pillars -}}
  {{- with site.GetPage (printf "pillar/%s" .) -}}
    {{- if or (.Params.sitemap.disable) (eq .Params.robotsNoIndex true) (in $seen .Permalink) }}{{ continue }}{{ end -}}
    {{- $pg := . -}}
    {{- $img := "" -}}{{- $imgT := "" -}}{{- $imgC := "" -}}
    {{- with .Params.cover.image -}}
      {{- $img = . | absURL -}}
      {{- $imgT = $pg.Title | plainify -}}
      {{- with $pg.Params.cover.alt -}}{{- $imgC = . | plainify -}}{{- end -}}
    {{- end -}}
    {{- $out = $out | append (dict "url" .Permalink "lastmod" (partial "sitemap_lastmod" .) "freq" "weekly" "prio" 0.9 "img" $img "imgtitle" $imgT "imgcap" $imgC) -}}
    {{- $seen = $seen | append .Permalink -}}
  {{- end -}}
{{- end -}}
{{- /* ---------- 4) Pillar-/Blog-Übersicht + Cockpit + Rechtliches/Über ---------- */ -}}
{{- range (slice "pillar" "posts") -}}
  {{- with site.GetPage (printf "/%s" .) -}}
    {{- if and .Permalink (not .Params.sitemap.disable) (ne .Params.robotsNoIndex true) (not (in $seen .Permalink)) -}}
      {{- $out = $out | append (dict "url" .Permalink "lastmod" (partial "sitemap_lastmod" .) "freq" "weekly" "prio" 0.6) -}}
      {{- $seen = $seen | append .Permalink -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- with site.GetPage "/cockpit" -}}
  {{- if and .Permalink (not .Params.sitemap.disable) (ne .Params.robotsNoIndex true) (not (in $seen .Permalink)) -}}
    {{- $out = $out | append (dict "url" .Permalink "lastmod" (partial "sitemap_lastmod" .) "freq" "weekly" "prio" 0.6) -}}
    {{- $seen = $seen | append .Permalink -}}
  {{- end -}}
{{- end -}}
{{- range $legal -}}
  {{- with site.GetPage (printf "/%s" .) -}}
    {{- if and .Permalink (not .Params.sitemap.disable) (ne .Params.robotsNoIndex true) (not (in $seen .Permalink)) -}}
      {{- $out = $out | append (dict "url" .Permalink "lastmod" (partial "sitemap_lastmod" .) "freq" "monthly" "prio" 0.3) -}}
      {{- $seen = $seen | append .Permalink -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{ printf `<?xml version="1.0" encoding="utf-8" standalone="yes"?>` | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{{- range $out }}
<url>
  <loc>{{ .url }}</loc>{{ with .lastmod }}
  <lastmod>{{ . }}</lastmod>{{ end }}
  <changefreq>{{ .freq }}</changefreq>
  <priority>{{ printf "%.1f" .prio }}</priority>
  {{- $e := . -}}
  {{- with $e.img }}
  <image:image>
    <image:loc>{{ . }}</image:loc>
    <image:title>{{ printf "%s" $e.imgtitle | html }}</image:title>
    {{- with $e.imgcap }}
    <image:caption>{{ printf "%s" . | html }}</image:caption>
    {{- end }}
  </image:image>
  {{- end }}
</url>{{- end }}
</urlset>
